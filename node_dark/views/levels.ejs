<%- include('partials/header.ejs') %><%- include('partials/navbar.ejs') %>
<main class="pagina-interna mapas-page">
  <section class="cabecalho-pagina mapas-banner">
    <span class="eyebrow">Um mundo conectado</span>
    <h1>Áreas de Lordran</h1>
    <p>
      Explore atalhos, fortalezas, ruínas e lugares onde cada caminho esconde um
      novo perigo.
    </p>
  </section>
  <section class="mapas-grid">
    <article class="mapa-card">
      <img src="/images/banner2.png" alt="Santuário do Elo de Fogo" />
      <div>
        <span>Área central</span>
        <h2>Santuário do Elo de Fogo</h2>
        <p>O ponto de descanso entre diferentes caminhos de Lordran.</p>
      </div>
    </article>
    <article class="mapa-card">
      <img src="/images/arnor.webp" alt="Anor Londo" />
      <div>
        <span>Cidade dos deuses</span>
        <h2>Anor Londo</h2>
        <p>Uma cidade majestosa protegida por guerreiros lendários.</p>
      </div>
    </article>
    <article class="mapa-card">
      <img src="/images/blighttown.jpg" alt="Blighttown" />
      <div>
        <span>Profundezas</span>
        <h2>Blighttown</h2>
        <p>
          Um pântano tóxico onde a escuridão e o perigo estão por todos os
          lados.
        </p>
      </div>
    </article>
    <article class="mapa-card">
      <img src="/images/arquivos.webp" alt="Arquivos do Duque" />
      <div>
        <span>Conhecimento proibido</span>
        <h2>Arquivos do Duque</h2>
        <p>Uma biblioteca colossal dominada pelo dragão Seath.</p>
      </div>
    </article>
    <article class="mapa-card">
      <img src="/images/tumba.jpg" alt="Tumba dos Gigantes" />
      <div>
        <span>Terra dos mortos</span>
        <h2>Tumba dos Gigantes</h2>
        <p>Um abismo sem luz, habitado por esqueletos gigantes.</p>
      </div>
    </article>
    <article class="mapa-card">
      <img src="/images/lostIzalith.png" alt="Izalith Perdida" />
      <div>
        <span>Berço do caos</span>
        <h2>Izalith Perdida</h2>
        <p>As ruínas de uma cidade consumida pelo fogo do caos.</p>
      </div>
    </article>
  </section>
</main>
<%- include('partials/footer.ejs') %>
